MONGODB_REPLICA_SET=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB_NAME=Mysic
MONGODB_USERS_COLLECTION=Mysic_usuarios

JWT_SECRET=replace_with_at_least_32_random_characters
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
