# Usa valores largos y diferentes. No guardes el archivo .env real en Git.
ACQUISITION_WORKER_TOKEN=replace-with-a-random-worker-token
MYSIC_N8N_TOKEN=replace-with-a-different-random-webhook-token

ACQUISITION_WORKER_PORT=4310
ACQUISITION_ALLOWED_HOSTS=music.youtube.com,www.youtube.com,youtube.com,youtu.be
MYSIC_N8N_WEBHOOK_BASE=http://127.0.0.1:5678/webhook

# Opcional si los ejecutables no están en PATH.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
