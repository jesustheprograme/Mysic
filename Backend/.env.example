PORT=4000
API_BIND_HOST=0.0.0.0
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Número de proxies confiables entre Internet y Express. Déjalo vacío en local.
TRUST_PROXY=

# PostgreSQL database used by Prisma
# Desarrollo local: no apuntes esta variable a mysic_bd de producción.
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@localhost:5432/mysic_bd_local?schema=public
MUSIC_LIBRARY_PATH=D:\Musica
FPCALC_PATH=C:\Program Files\MusicBrainz Picard\fpcalc.exe
PICARD_PATH=C:\Program Files\MusicBrainz Picard\picard.exe
# musicbrainz usa fpcalc/AcoustID; picard ejecuta SCAN y lee sus etiquetas desde una copia temporal
METADATA_ENGINE=musicbrainz
ACOUSTID_API_KEY=your_free_acoustid_api_key
ACOUSTID_MIN_SCORE=0.85
MUSICBRAINZ_USER_AGENT=AutomaMysic/1.0 (your-email-or-url)
NAVIDROME_URL=http://YOUR_SERVER:4533
NAVIDROME_USER=your_navidrome_user
NAVIDROME_PASSWORD=your_navidrome_password
MUSIC_SSH_HOST=YOUR_SERVER
MUSIC_SSH_USER=your_ssh_user
MUSIC_SSH_KEY_PATH=C:\\Users\\you\\.ssh\\id_ed25519
MUSIC_SSH_ROOT=/music
# La aplicación de escritorio usa estas variables para previsualizar y subir MP3 por SSH.
# Nunca sobrescribe un archivo remoto que ya exista.

# Imágenes de Cloudinary; guardar valores reales en .env.cloudinary (ignorado por Git)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# dynamic (predeterminado) o fixed para cuentas antiguas
CLOUDINARY_FOLDER_MODE=dynamic

# Almacenamiento S3-compatible para audio (Cloudflare R2 en producción)
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=mysic-audio
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Dominio público con caché. Déjalo vacío para generar URLs privadas temporales.
AUDIO_CDN_BASE_URL=
AUDIO_URL_TTL_SECONDS=900

MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_CLUSTER_HOST=
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB_NAME=Mysic_local
MONGODB_USERS_COLLECTION=Mysic_usuarios
MUSIC_IMPORT_ADMIN_EMAIL=jesusobregon2010@gmail.com

JWT_SECRET=replace_with_at_least_32_random_characters
# Cliente principal del entorno que ejecuta este backend.
GOOGLE_CLIENT_ID=your_local_or_deployed_web_client_id.apps.googleusercontent.com
# Opcional: clientes adicionales aceptados durante despliegues o migraciones.
GOOGLE_CLIENT_IDS=your_local_web_client_id.apps.googleusercontent.com,your_deployed_web_client_id.apps.googleusercontent.com
