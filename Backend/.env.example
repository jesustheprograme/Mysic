PORT=4000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL database used by Prisma
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@localhost:5432/mysic_bd?schema=public
MUSIC_LIBRARY_PATH=D:\Musica
NAVIDROME_URL=http://YOUR_SERVER:4533
NAVIDROME_USER=your_navidrome_user
NAVIDROME_PASSWORD=your_navidrome_password
MUSIC_SSH_HOST=YOUR_SERVER
MUSIC_SSH_USER=your_ssh_user
MUSIC_SSH_KEY_PATH=C:\\Users\\you\\.ssh\\id_ed25519
MUSIC_SSH_ROOT=/music

# Imágenes de Cloudinary; guardar valores reales en .env.cloudinary (ignorado por Git)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# dynamic (predeterminado) o fixed para cuentas antiguas
CLOUDINARY_FOLDER_MODE=dynamic

MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_CLUSTER_HOST=
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB_NAME=Mysic
MONGODB_USERS_COLLECTION=Mysic_usuarios

JWT_SECRET=replace_with_at_least_32_random_characters
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=your_web_client_id.apps.googleusercontent.com,your_desktop_client_id.apps.googleusercontent.com
